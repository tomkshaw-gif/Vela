{
  "name": "@luxalgo/vela",
  "private": true,
  "localReplayStudio": "Local-only fork application; upstream library attribution and license retained.",
  "version": "0.8.5",
  "description": "The open-source core of Vela by LuxAlgo: a charting library with a native high-performance renderer, drawing tools, pluggable chart types and pluggable scripting engines.",
  "keywords": [
    "charting library",
    "financial charts",
    "trading charts",
    "candlestick chart",
    "stock chart",
    "crypto chart",
    "webgl",
    "canvas",
    "technical analysis",
    "indicators",
    "drawing tools",
    "orderflow",
    "pine script",
    "pinets",
    "lightweight-charts alternative",
    "typescript",
    "luxalgo",
    "vela"
  ],
  "license": "Apache-2.0",
  "homepage": "https://velacharts.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxalgo/vela.git"
  },
  "bugs": {
    "url": "https://github.com/luxalgo/vela/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/binance": {
      "types": "./dist/providers/binance.d.ts",
      "import": "./dist/providers/binance.js",
      "require": "./dist/providers/binance.cjs"
    },
    "./providers/hyperliquid": {
      "types": "./dist/providers/hyperliquid.d.ts",
      "import": "./dist/providers/hyperliquid.js",
      "require": "./dist/providers/hyperliquid.cjs"
    },
    "./providers/coinbase": {
      "types": "./dist/providers/coinbase.d.ts",
      "import": "./dist/providers/coinbase.js",
      "require": "./dist/providers/coinbase.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "author": "LuxAlgo",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p local-app/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "playground": "vite",
    "local:build": "vite build --config local-app/vite.config.ts",
    "local:start": "node local-app/launch.mjs",
    "local:dev": "node local-app/launch.mjs --mode develop",
    "local:server": "tsx local-app/server/index.ts",
    "local:ui": "vite --config local-app/vite.config.ts",
    "local:test": "vitest run local-app/test",
    "local:mcp": "node --import tsx local-app/mcp.ts",
    "desktop:build": "node local-app/electron/build.mjs",
    "desktop:dist": "node local-app/electron/build.mjs --dist",
    "desktop:start": "electron local-app/electron/staging/app",
    "desktop:appearance": "node local-app/electron/install-appearance.mjs"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "^24.19.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@luxalgo/edge-stats": "file:vendor/edge-stats",
    "luxon": "3.7.2",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@luxalgo/vela-pinets": "0.2.17",
    "@modelcontextprotocol/server": "2.3.1",
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0",
    "codemirror": "6.0.2",
    "electron-updater": "6.8.9",
    "pinets": "0.12.0",
    "zod": "4.6.7"
  }
}
